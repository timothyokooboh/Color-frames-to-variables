{
  "name": "color-frames-to-variables",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @color-frames/ui dev",
    "build": "pnpm --filter @color-frames/ui build && pnpm --filter @color-frames/plugin build && node scripts/verify-build.mjs",
    "dev:plugin": "pnpm build && pnpm --parallel --filter @color-frames/ui --filter @color-frames/plugin watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "acceptance:build": "node scripts/build-acceptance.mjs",
    "release:assets": "node scripts/build-release-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "license": "MIT"
}
